# Copy to /etc/shph/host.env and chmod 600.
# This example intentionally contains no real endpoint, ticket, key, or
# password. Replace every value before enabling the service.
SHPH_ADVERTISE=replace-with-owned-public-endpoint:443
SHPH_PORT=443
SHPH_TRANSPORT=tcp
SHPH_SHROUD_PROFILE=medium

# For an encrypted keystore, add the password interactively during deployment:
# SHPH_KEYSTORE_PASSWORD=replace-me
